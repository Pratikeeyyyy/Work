# Copy to .env and fill in before deploying to a live network.
# Hardhat loads this file automatically via dotenv.

# RPC endpoint for the target network (Infura/Alchemy/your node)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

# EOA private key that deploys the escrow (the client) - NEVER COMMIT THIS
PRIVATE_KEY=

# Optional: addresses used by scripts/deploy.js
FREELANCER_ADDRESS=
MEDIATOR_ADDRESS=

# Escrow deposit amount in ETH (scripts/deploy.js)
AMOUNT_ETH=0.1

# Etherscan API key for `hardhat verify`
ETHERSCAN_API_KEY=